---
import { localizePath, useTranslations, type Locale } from '../i18n'
import { resolveText } from '../i18n/text'
import { formatDate } from '../lib/date'
import { withUnit } from '../lib/units'
import type { Organization, ReportItem, Tag } from '../lib/types'
import Badge from './ui/Badge.astro'
import Icon from './ui/Icon.astro'
import LocalizedTextView from './LocalizedText.astro'
import PhotoImage from './PhotoImage.astro'
import Ruby from './Ruby.astro'

interface Props {
  report: ReportItem
  locale: Locale
  tags: Tag[]
  organization?: Organization
}

const { report, locale, tags, organization } = Astro.props
const t = useTranslations(locale)

const reportTags = report.tagIds
  .map((id) => tags.find((tag) => tag.id === id))
  .filter((tag) => !!tag)

const cover = report.photos[0]
---

<article
  class="group min-w-0"
  data-report
  data-org={report.organizationId}
  data-tags={report.tagIds.join(' ')}
  data-year={report.heldOn.slice(0, 4)}
>
  <a
    href={localizePath(`/reports/${report.slug}`, locale)}
    class="flex h-full flex-col overflow-hidden rounded-card bg-white ring-1 ring-snow-200 transition-all duration-200 hover:-translate-y-0.5 hover:shadow-lg hover:shadow-brand-900/5 hover:ring-brand-200"
  >
    <div class="relative aspect-16/9 overflow-hidden bg-brand-900">
      <PhotoImage photoId={cover?.photoId} seed={report.slug} class="transition-transform duration-500 group-hover:scale-105" />
      {
        report.photos.length > 1 && (
          <span class="absolute right-3 bottom-3 inline-flex items-center gap-1 rounded-full bg-snow-900/70 px-2.5 py-1 text-xs font-semibold text-white">
            <Icon name="camera" class="size-3.5" />
            {report.photos.length}
          </span>
        )
      }
    </div>

    <div class="flex flex-1 flex-col p-5">
      <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-snow-500">
        <time datetime={report.heldOn}>
          <Ruby text={formatDate(report.heldOn, locale, { weekday: false })} />
        </time>
        {
          report.participants !== undefined && (
            <span class="flex items-center gap-1">
              <Icon name="users" class="size-3.5" />
              {withUnit(report.participants, t('unit.people'), locale)}
            </span>
          )
        }
      </div>

      <h3 class="text-balance-ja mt-2 line-clamp-2 text-lg leading-snug font-bold transition-colors group-hover:text-brand-700">
        <LocalizedTextView field={report.title} locale={locale} notice={false} />
      </h3>

      <p class="text-balance-ja mt-2 line-clamp-3 flex-1 text-sm text-snow-600">
        <LocalizedTextView field={report.summary} locale={locale} notice={false} />
      </p>

      {
        organization && (
          <p class="mt-4 flex items-center gap-1.5 border-t border-snow-200 pt-3 text-xs text-snow-500">
            <Icon name="building" class="size-3.5" />
            <span class="min-w-0 truncate">
              <LocalizedTextView field={organization.shortName} locale={locale} notice={false} />
            </span>
          </p>
        )
      }

      {
        reportTags.length > 0 && (
          <div class="mt-3 flex flex-wrap gap-1.5">
            {reportTags.map((tag) => (
              <Badge tone={tag!.tone}><Ruby text={resolveText(tag!.name, locale).text} /></Badge>
            ))}
          </div>
        )
      }
    </div>
  </a>
</article>

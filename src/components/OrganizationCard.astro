---
import { localizePath, useTranslations, type Locale } from '../i18n'
import type { Organization } from '../lib/types'
import Badge from './ui/Badge.astro'
import Icon from './ui/Icon.astro'
import LocalizedTextView from './LocalizedText.astro'
import PhotoImage from './PhotoImage.astro'
import Ruby from './Ruby.astro'

interface Props {
  organization: Organization
  locale: Locale
  /** その団体のイベント数・活動報告数 */
  counts: { events: number; reports: number }
}

const { organization, locale, counts } = Astro.props
const t = useTranslations(locale)
---

<article class="group min-w-0">
  <a
    href={localizePath(`/organizations/${organization.slug}`, locale)}
    class="flex h-full flex-col overflow-hidden rounded-card bg-white border-2 border-faded-gray transition-colors hover:border-eager-green"
  >
    <div class="relative h-32 overflow-hidden border-b-2 border-faded-gray bg-storybook-green">
      <PhotoImage photoId={organization.imageId} seed={organization.slug} class="transition-colors" />
      {
        organization.recruiting && (
          <span class="absolute top-3 right-3">
            <Badge tone="emerald" variant="solid"><Ruby text={t('org.recruiting')} /></Badge>
          </span>
        )
      }
    </div>

    <div class="flex flex-1 flex-col p-5">
      <h3 class="text-balance-ja line-clamp-2 text-lg leading-snug font-extrabold text-charcoal">
        <LocalizedTextView field={organization.name} locale={locale} notice={false} />
      </h3>
      <p class="text-balance-ja mt-2 line-clamp-2 text-sm text-pencil-gray">
        <LocalizedTextView field={organization.philosophy} locale={locale} notice={false} />
      </p>

      <dl class="mt-4 flex-1 space-y-1.5 text-xs text-pencil-gray">
        <div class="flex items-center gap-1.5">
          <dt class="sr-only"><Ruby text={t('nav.events')} /></dt>
          <Icon name="calendar" class="size-3.5" />
          <dd>{counts.events}</dd>
          <dt class="sr-only"><Ruby text={t('nav.reports')} /></dt>
          <Icon name="camera" class="ml-2 size-3.5" />
          <dd>{counts.reports}</dd>
        </div>
      </dl>

      <span class="mt-4 inline-flex items-center gap-1 border-t border-faded-gray pt-3 text-sm font-bold text-blue-text">
        <Ruby text={t('common.readMore')} />
        <Icon name="arrow-right" class="size-4 transition-transform group-hover:translate-x-0.5" />
      </span>
    </div>
  </a>
</article>

---
import { localizePath, useTranslations, type Locale } from '../i18n'
import { resolveText } from '../i18n/text'
import { formatMonth } from '../lib/date'
import { stripRuby } from '../lib/ruby'
import { calendarCells, dateOf, timeOf } from '../lib/event-helpers'
import type { EventItem, Tag } from '../lib/types'
import Ruby from './Ruby.astro'

/**
 * 1か月ぶんのカレンダー。
 *
 * 静的サイトなので月送りのJSは持たず、イベントがある月をページ側で
 * 縦に並べる。スマートフォンでは各マスが狭いため、開始時刻だけを出し、
 * 画面が広がるとイベント名も表示する。
 */
interface Props {
  month: string
  events: EventItem[]
  locale: Locale
  tags: Tag[]
}

const { month, events, locale, tags } = Astro.props
const t = useTranslations(locale)

const weekdays = t('calendar.weekdays').split(',')
const cells = calendarCells(month)

/** 日付ごとにイベントをまとめておく */
const byDate = new Map<string, EventItem[]>()
for (const event of events) {
  const key = dateOf(event.startAt)
  byDate.set(key, [...(byDate.get(key) ?? []), event])
}

const toneOf = (event: EventItem): string => {
  const tag = tags.find((candidate) => candidate.id === event.tagIds[0])
  return tag?.tone ?? 'brand'
}

/**
 * カレンダーのチップ。DESIGN.md は副次パレットをUIに使わないため、
 * タグの色分けは持ち込まず、緑・青・グレーの3種類に寄せている。
 */
const CHIP: Record<string, string> = {
  brand: 'border-spark-blue bg-spark-blue/10 text-blue-text',
  sky: 'border-spark-blue bg-spark-blue/10 text-blue-text',
  emerald: 'border-eager-green bg-storybook-green text-green-text',
  hanabi: 'border-eager-green bg-storybook-green text-green-text',
  violet: 'border-faded-gray bg-paper-white text-charcoal',
  amber: 'border-faded-gray bg-paper-white text-charcoal',
  rose: 'border-faded-gray bg-paper-white text-charcoal',
  slate: 'border-faded-gray bg-paper-white text-charcoal',
}
---

<section class="min-w-0" aria-label={stripRuby(formatMonth(month, locale))}>
  <h3 class="mb-3 text-lg font-bold">
    <Ruby text={formatMonth(month, locale)} />
  </h3>

  <div class="overflow-hidden rounded-card border-2 border-faded-gray">
    <div class="grid grid-cols-7 bg-paper-white text-center text-xs font-bold text-pencil-gray">
      {
        weekdays.map((day, index) => (
          <div
            class:list={[
              'py-2',
              index === 0 && 'text-rose-600',
              index === 6 && 'text-sky-600',
            ]}
          >
            <Ruby text={day} />
          </div>
        ))
      }
    </div>

    <div class="grid grid-cols-7 bg-faded-gray gap-px">
      {
        cells.map((cell) => {
          const dayEvents = byDate.get(cell.date) ?? []
          const dayNumber = Number(cell.date.slice(8))
          return (
            <div
              class:list={[
                'min-h-16 bg-white p-1 sm:min-h-24 sm:p-1.5',
                !cell.inMonth && 'bg-paper-white',
              ]}
            >
              <div
                class:list={[
                  'text-right text-[0.7rem] tabular-nums sm:text-xs',
                  cell.inMonth ? 'text-pencil-gray' : 'text-faded-gray',
                ]}
              >
                {dayNumber}
              </div>
              <div class="mt-0.5 flex flex-col gap-0.5">
                {dayEvents.map((event) => (
                  <a
                    href={localizePath(`/events/${event.slug}`, locale)}
                    class:list={[
                      'block min-w-0 truncate rounded px-1 py-0.5 text-[0.65rem] leading-tight font-medium transition-colors sm:text-[0.7rem]',
                      CHIP[toneOf(event)],
                    ]}
                    title={stripRuby(resolveText(event.title, locale).text)}
                  >
                    <span class="sm:hidden">{timeOf(event.startAt)}</span>
                    <span class="hidden sm:inline">
                      {timeOf(event.startAt)}{' '}
                      <Ruby text={resolveText(event.title, locale).text} />
                    </span>
                  </a>
                ))}
              </div>
            </div>
          )
        })
      }
    </div>
  </div>
</section>

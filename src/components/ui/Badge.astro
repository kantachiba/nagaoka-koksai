---
/**
 * タグ・状態を示すピル。
 *
 * DESIGN.md は「副次パレット（紫・橙など）をUIに使わない」としているため、
 * データ側の tone は緑・青・グレーの3種類に寄せて描く。
 * 造形は 12px 角丸＋2px 枠線で、シールのような見え方に揃える。
 */
export type BadgeTone =
  | 'brand' | 'hanabi' | 'emerald' | 'violet' | 'sky' | 'amber' | 'rose' | 'slate'

/** データ側の色分けを、許容された3種類へ割り当てる */
const CLASS_OF: Record<BadgeTone, string> = {
  emerald: 'pill-green',
  hanabi: 'pill-green',
  brand: 'pill-blue',
  sky: 'pill-blue',
  violet: 'pill-gray',
  amber: 'pill-gray',
  rose: 'pill-gray',
  slate: 'pill-gray',
}

interface Props {
  tone?: BadgeTone
  /** 面で塗るか（濃い背景の上など）。既定は枠線のみ */
  variant?: 'soft' | 'solid'
  size?: 'sm' | 'md'
  class?: string
}

const { tone = 'slate', variant = 'soft', size = 'sm', class: className = '' } = Astro.props
---

<span
  class:list={[
    CLASS_OF[tone],
    variant === 'solid' && 'border-eager-green bg-eager-green text-night-ink',
    size === 'md' && 'px-4 py-1.5 text-sm',
    className,
  ]}
>
  <slot />
</span>

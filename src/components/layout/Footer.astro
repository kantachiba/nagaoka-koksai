---
import { localizePath, useTranslations, type Locale, type UiKey } from '../../i18n'
import { resolveText } from '../../i18n/text'
import { SITE_NAME } from '../../config/site'
import Container from '../ui/Container.astro'
import Icon from '../ui/Icon.astro'
import LanguageSwitcher from '../LanguageSwitcher.astro'
import Ruby from '../Ruby.astro'
import Logo from './Logo.astro'

/**
 * ページ下端の緑帯（DESIGN.md の Footer Background）。
 *
 * ⚠️ DESIGN.md は緑地に白文字としているが、その組み合わせは 2.09:1 で
 *    WCAG AA を満たさない。面の緑はそのままに、文字は濃色（9.37:1）にしている。
 */
interface Props {
  locale: Locale
}

const { locale } = Astro.props
const t = useTranslations(locale)

const LINKS: Array<{ path: string; key: UiKey }> = [
  { path: '/', key: 'nav.home' },
  { path: '/events', key: 'nav.events' },
  { path: '/reports', key: 'nav.reports' },
  { path: '/organizations', key: 'nav.organizations' },
]

const siteName = resolveText(SITE_NAME, locale).text
---

<footer class="mt-20 bg-eager-green text-night-ink">
  <Container class="py-12 sm:py-16">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
      <div class="lg:col-span-2">
        <div class="flex items-center gap-3">
          <Logo class="size-11 shrink-0" />
          <span class="text-balance-ja text-xl font-extrabold"><Ruby text={siteName} /></span>
        </div>
        <p class="text-balance-ja mt-4 max-w-md leading-relaxed">
          <Ruby text={t('footer.aboutBody')} />
        </p>
        <div class="mt-6">
          <p class="mb-2 text-xs font-bold uppercase"><Ruby text={t('lang.label')} /></p>
          <div class="inline-block rounded-card bg-paper-white p-0.5">
            <LanguageSwitcher locale={locale} />
          </div>
        </div>
      </div>

      <nav aria-labelledby="footer-contents">
        <h2 id="footer-contents" class="text-sm font-extrabold uppercase">
          <Ruby text={t('footer.contents')} />
        </h2>
        <ul class="mt-4 space-y-2">
          {
            LINKS.map((link) => (
              <li>
                <a
                  href={localizePath(link.path, locale)}
                  class="inline-flex items-center gap-1.5 rounded-card px-2 py-1 font-bold transition-colors hover:bg-paper-white"
                >
                  <Icon name="arrow-right" class="size-4" />
                  <Ruby text={t(link.key)} />
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div>
        <h2 class="text-sm font-extrabold uppercase"><Ruby text={t('footer.contact')} /></h2>
        <p class="text-balance-ja mt-4 leading-relaxed">
          <Ruby text={t('footer.contactBody')} />
        </p>
      </div>
    </div>

    <div
      class="mt-10 flex flex-col gap-3 border-t-2 border-night-ink/25 pt-6 text-sm sm:flex-row sm:items-center sm:justify-between"
    >
      <p>© {new Date().getFullYear()} Nagaoka International Portal</p>
      <p class="flex items-center gap-1.5">
        <Icon name="info" class="size-4" />
        <Ruby text={t('footer.copyright')} />
      </p>
    </div>
  </Container>
</footer>

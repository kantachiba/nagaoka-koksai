---
import { localizePath, type Locale } from '../../i18n'
import { useTranslations } from '../../i18n'
import Container from '../ui/Container.astro'
import Ruby from '../Ruby.astro'

/** 一覧ページ共通の見出しとパンくず */
interface Props {
  locale: Locale
  title: string
  lead?: string
  /** パンくず。最後の要素が現在位置 */
  crumbs: Array<{ label: string; path?: string }>
}

const { locale, title, lead, crumbs } = Astro.props
const t = useTranslations(locale)
---

<div class="border-b-2 border-faded-gray bg-paper-white">
  <Container>
    <nav aria-label={t('common.breadcrumb')} class="py-4">
      <ol class="flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-pencil-gray">
        {
          crumbs.map((crumb, index) => {
            const isLast = index === crumbs.length - 1
            return (
              <li class="flex items-center gap-2">
                {crumb.path && !isLast ? (
                  <a href={localizePath(crumb.path, locale)} class="rounded hover:text-blue-text hover:underline">
                    <Ruby text={crumb.label} />
                  </a>
                ) : (
                  <span class={isLast ? 'font-medium text-charcoal' : undefined} aria-current={isLast ? 'page' : undefined}>
                    <Ruby text={crumb.label} />
                  </span>
                )}
                {!isLast && <span aria-hidden="true" class="text-faded-gray">／</span>}
              </li>
            )
          })
        }
      </ol>
    </nav>

    <div class="max-w-3xl pt-2 pb-10">
      <h1 class="section-title text-balance-ja"><Ruby text={title} /></h1>
      {lead && <p class="lead text-balance-ja mt-4"><Ruby text={lead} /></p>}
      <slot />
    </div>
  </Container>
</div>

---
/**
 * サイトのシンボルマーク。長岡花火をモチーフにした放射。
 * 正式なロゴが決まったら SITE_LOGO_PATH に画像を置いて差し替える。
 */
interface Props {
  class?: string
}
const { class: className = 'size-9' } = Astro.props

const spokes = Array.from({ length: 12 }, (_, i) => {
  const angle = (i / 12) * Math.PI * 2 - Math.PI / 2
  const outer = i % 2 === 0 ? 15 : 11
  return {
    x1: 20 + Math.cos(angle) * 6,
    y1: 20 + Math.sin(angle) * 6,
    x2: 20 + Math.cos(angle) * outer,
    y2: 20 + Math.sin(angle) * outer,
    width: i % 2 === 0 ? 2 : 1.4,
    opacity: i % 2 === 0 ? 1 : 0.7,
  }
})
---

<svg viewBox="0 0 40 40" class={className} aria-hidden="true">
  <circle cx="20" cy="20" r="20" class="fill-brand-800"></circle>
  <g stroke="currentColor" stroke-linecap="round" class="text-hanabi-400">
    {
      spokes.map((s) => (
        <line x1={s.x1} y1={s.y1} x2={s.x2} y2={s.y2} stroke-width={s.width} opacity={s.opacity} />
      ))
    }
  </g>
  <circle cx="20" cy="20" r="3.4" class="fill-white"></circle>
</svg>

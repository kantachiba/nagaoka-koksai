---
/**
 * シンボルマーク。長岡花火をモチーフにした放射。
 * 太い輪郭と平らな塗りで、シールのような見え方にしている（DESIGN.md）。
 */
interface Props {
  class?: string
}
const { class: className = 'size-10' } = Astro.props

const spokes = Array.from({ length: 8 }, (_, i) => {
  const angle = (i / 8) * Math.PI * 2 - Math.PI / 2
  return {
    x1: 24 + Math.cos(angle) * 7,
    y1: 24 + Math.sin(angle) * 7,
    x2: 24 + Math.cos(angle) * 15,
    y2: 24 + Math.sin(angle) * 15,
  }
})
---

<svg viewBox="0 0 48 48" class={className} aria-hidden="true">
  <circle cx="24" cy="24" r="22" class="fill-eager-green" stroke="#000437" stroke-width="3"></circle>
  <g stroke="#ffffff" stroke-width="3" stroke-linecap="round">
    {spokes.map((s) => <line x1={s.x1} y1={s.y1} x2={s.x2} y2={s.y2} />)}
  </g>
  <circle cx="24" cy="24" r="4" class="fill-paper-white"></circle>
</svg>

---
import { localizePath, useTranslations, type Locale } from '../i18n'
import { resolveText } from '../i18n/text'
import { formatDate } from '../lib/date'
import { dateOf, getEventStatus, isFinished, timeOf } from '../lib/event-helpers'
import type { EventItem, Organization, Tag } from '../lib/types'
import Badge from './ui/Badge.astro'
import Icon from './ui/Icon.astro'
import LocalizedTextView from './LocalizedText.astro'
import Ruby from './Ruby.astro'

/**
 * イベント1件のカード。
 *
 * 絞り込みは静的サイトなのでブラウザ側で行う。JS から扱えるよう、
 * 条件になる値を data-* 属性で持たせている（events/index.astro のスクリプト参照）。
 */
interface Props {
  event: EventItem
  locale: Locale
  tags: Tag[]
  organization?: Organization
}

const { event, locale, tags, organization } = Astro.props
const t = useTranslations(locale)
const status = getEventStatus(event)
const finished = isFinished(event)

const eventTags = event.tagIds
  .map((id) => tags.find((tag) => tag.id === id))
  .filter((tag): tag is Tag => !!tag)

const startDate = dateOf(event.startAt)
const endDate = dateOf(event.endAt)
const multiDay = startDate !== endDate
---

<article
  class="group min-w-0"
  data-event
  data-tags={event.tagIds.join(' ')}
  data-langs={event.supportLanguages.join(' ')}
  data-free={String(event.isFree)}
  data-start={startDate}
>
  <a
    href={localizePath(`/events/${event.slug}`, locale)}
    class="flex h-full flex-col rounded-card bg-white p-5 ring-1 ring-snow-200 transition-all duration-200 hover:-translate-y-0.5 hover:shadow-lg hover:shadow-brand-900/5 hover:ring-brand-200"
  >
    <div class="flex flex-wrap items-center gap-1.5">
      <Badge tone={status.tone}><Ruby text={t(status.key)} /></Badge>
      {event.isFree && <Badge tone="emerald"><Ruby text={t('common.free')} /></Badge>}
      {
        event.visibility === 'invite' && (
          <Badge tone="amber"><Ruby text={t('event.visibility.invite')} /></Badge>
        )
      }
    </div>

    <p class="mt-3 flex items-center gap-2 text-sm font-bold text-brand-700">
      <Icon name="calendar" class="size-4" />
      <time datetime={startDate}>
        <Ruby text={formatDate(startDate, locale)} />
      </time>
      {multiDay && <span aria-hidden="true">〜</span>}
      {multiDay && <time datetime={endDate}><Ruby text={formatDate(endDate, locale, { year: false })} /></time>}
    </p>

    <h3
      class="text-balance-ja mt-2 line-clamp-2 text-lg leading-snug font-bold transition-colors group-hover:text-brand-700"
    >
      <LocalizedTextView field={event.title} locale={locale} notice={false} />
    </h3>

    <p class="text-balance-ja mt-2 line-clamp-2 flex-1 text-sm text-snow-600">
      <LocalizedTextView field={event.summary} locale={locale} notice={false} />
    </p>

    <dl class="mt-4 space-y-1.5 border-t border-snow-200 pt-3 text-xs text-snow-500">
      <div class="flex items-center gap-1.5">
        <dt class="sr-only">{t('event.time')}</dt>
        <Icon name="clock" class="size-3.5" />
        <dd>{timeOf(event.startAt)}〜{timeOf(event.endAt)}</dd>
      </div>
      <div class="flex items-center gap-1.5">
        <dt class="sr-only">{t('event.venue')}</dt>
        <Icon name="map-pin" class="size-3.5" />
        <dd class="min-w-0 truncate">
          <LocalizedTextView field={event.venue} locale={locale} notice={false} />
        </dd>
      </div>
      <div class="flex items-center gap-1.5">
        <dt class="sr-only">{t('event.fee')}</dt>
        <Icon name="ticket" class="size-3.5" />
        <dd class:list={['min-w-0 truncate', event.isFree && 'font-bold text-emerald-700']}>
          <LocalizedTextView field={event.fee} locale={locale} notice={false} />
        </dd>
      </div>
      {
        organization && (
          <div class="flex items-center gap-1.5">
            <dt class="sr-only">{t('event.organizer')}</dt>
            <Icon name="building" class="size-3.5" />
            <dd class="min-w-0 truncate">
              <LocalizedTextView field={organization.shortName} locale={locale} notice={false} />
            </dd>
          </div>
        )
      }
    </dl>

    {
      eventTags.length > 0 && (
        <div class="mt-3 flex flex-wrap gap-1.5">
          {eventTags.map((tag) => (
            <Badge tone={tag.tone}>
              <Ruby text={resolveText(tag.name, locale).text} />
            </Badge>
          ))}
        </div>
      )
    }

    {
      finished && (
        <p class="mt-3 rounded-lg bg-snow-100 px-3 py-2 text-xs text-snow-500">
          <Ruby text={t('event.status.finished')} />
        </p>
      )
    }
  </a>
</article>

---
import { localizePath, stripLocale, useTranslations, type Locale } from '../i18n'
import Icon from './ui/Icon.astro'
import Ruby from './Ruby.astro'

/**
 * スマホで画面下に固定する主ボタン。
 * イベント一覧・問い合わせなど、すでに目的の操作があるページでは出さない。
 */
interface Props {
  locale: Locale
}

const { locale } = Astro.props
const t = useTranslations(locale)
const path = stripLocale(Astro.url.pathname.replace(/\/+$/, '') || '/')
const hidden = path === '/events'
---

{
  !hidden && (
    <div id="sticky-cta" class="pointer-events-none fixed inset-x-0 bottom-0 z-40 px-4 pb-[max(1rem,env(safe-area-inset-bottom))] lg:hidden">
      <a href={localizePath('/events', locale)} class="btn-primary pointer-events-auto w-full shadow-none">
        <Icon name="calendar" class="size-5" />
        <Ruby text={t('sticky.cta')} />
      </a>
    </div>
  )
}

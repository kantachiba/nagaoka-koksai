---
import { DEFAULT_LOCALE, localizePath, useTranslations } from '../i18n'
import BaseLayout from '../layouts/BaseLayout.astro'
import Container from '../components/ui/Container.astro'
import Icon from '../components/ui/Icon.astro'

/**
 * 404 ページ。Firebase Hosting が dist/404.html を自動で使う。
 * 言語別のURLを持てないので、既定言語（日本語）で表示する。
 */
const locale = DEFAULT_LOCALE
const t = useTranslations(locale)
---

<BaseLayout locale={locale} path="/404" title={t('notfound.title')}>
  <Container class="py-24 text-center sm:py-32">
    <p class="text-6xl font-bold text-storybook-green sm:text-8xl">404</p>
    <h1 class="mt-4 text-2xl sm:text-3xl">{t('notfound.title')}</h1>
    <p class="text-balance-ja mx-auto mt-4 max-w-md text-pencil-gray">{t('notfound.body')}</p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a
        href={localizePath('/', locale)}
        class="btn-primary"
      >
        <Icon name="arrow-left" class="size-5" />
        {t('notfound.back')}
      </a>
    </div>
  </Container>
</BaseLayout>

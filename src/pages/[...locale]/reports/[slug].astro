---
import { LOCALES, localizePath, useTranslations, type Locale } from '../../../i18n'
import { resolveText } from '../../../i18n/text'
import { stripRuby } from '../../../lib/ruby'
import { resolveDoc } from '../../../lib/blocks'
import { formatDate } from '../../../lib/date'
import { withUnit } from '../../../lib/units'
import { findOrganization, getContent } from '../../../lib/content'
import BaseLayout from '../../../layouts/BaseLayout.astro'
import Container from '../../../components/ui/Container.astro'
import Badge from '../../../components/ui/Badge.astro'
import Icon from '../../../components/ui/Icon.astro'
import LocalizedTextView from '../../../components/LocalizedText.astro'
import PhotoImage from '../../../components/PhotoImage.astro'
import ReportCard from '../../../components/ReportCard.astro'
import Ruby from '../../../components/Ruby.astro'
import BlockContent from '../../../components/BlockContent.astro'

export async function getStaticPaths() {
  const bundle = await getContent()
  return LOCALES.flatMap((locale) =>
    bundle.reports.map((report) => ({
      params: { locale: locale === 'ja' ? undefined : locale, slug: report.slug },
      props: { locale, reportId: report.id },
    })),
  )
}

const { locale, reportId } = Astro.props as { locale: Locale; reportId: string }
const t = useTranslations(locale)

const bundle = await getContent()
const report = bundle.reports.find((candidate) => candidate.id === reportId)!
const organization = findOrganization(bundle, report.organizationId)
const relatedEvent = report.relatedEventId
  ? bundle.events.find((event) => event.id === report.relatedEventId)
  : undefined
const others = bundle.reports.filter((candidate) => candidate.id !== report.id).slice(0, 3)

const reportTags = report.tagIds.map((id) => bundle.tags.find((tag) => tag.id === id)).filter((tag) => !!tag)
const { doc: body } = resolveDoc(report.body, locale)
const title = resolveText(report.title, locale).text
const summary = resolveText(report.summary, locale).text
const cover = report.photos[0]
---

<BaseLayout
  locale={locale}
  path={`/reports/${report.slug}`}
  title={title}
  description={stripRuby(summary)}
  ogImage={cover ? new URL(`/photos/${cover.photoId}.jpg`, Astro.site).href : undefined}
>
  <Container>
    <nav aria-label={t('common.breadcrumb')} class="py-4">
      <ol class="flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-pencil-gray">
        <li><a href={localizePath('/', locale)} class="hover:text-blue-text hover:underline"><Ruby text={t('nav.home')} /></a></li>
        <li aria-hidden="true" class="text-faded-gray">／</li>
        <li><a href={localizePath('/reports', locale)} class="hover:text-blue-text hover:underline"><Ruby text={t('nav.reports')} /></a></li>
        <li aria-hidden="true" class="text-faded-gray">／</li>
        <li class="font-medium text-charcoal" aria-current="page"><Ruby text={title} /></li>
      </ol>
    </nav>
  </Container>

  <Container size="narrow" class="pb-16">
    <article>
      <header>
        <div class="flex flex-wrap gap-1.5">
          {reportTags.map((tag) => (
            <Badge tone={tag!.tone} size="md"><Ruby text={resolveText(tag!.name, locale).text} /></Badge>
          ))}
        </div>

        <h1 class="text-balance-ja mt-4 text-3xl leading-snug sm:text-4xl">
          <LocalizedTextView field={report.title} locale={locale} />
        </h1>

        <dl class="mt-6 flex flex-wrap gap-x-6 gap-y-2 text-sm text-pencil-gray">
          <div class="flex items-center gap-1.5">
            <dt class="sr-only"><Ruby text={t('report.heldOn')} /></dt>
            <Icon name="calendar" class="size-4 text-blue-text" />
            <dd><Ruby text={t('report.heldOn')} />：<time datetime={report.heldOn}><Ruby text={formatDate(report.heldOn, locale)} /></time></dd>
          </div>
          {
            report.participants !== undefined && (
              <div class="flex items-center gap-1.5">
                <dt class="sr-only"><Ruby text={t('report.participants')} /></dt>
                <Icon name="users" class="size-4 text-blue-text" />
                <dd><Ruby text={t('report.participants')} />：{withUnit(report.participants, t('unit.people'), locale)}</dd>
              </div>
            )
          }
          {
            organization && (
              <div class="flex items-center gap-1.5">
                <dt class="sr-only"><Ruby text={t('report.relatedOrg')} /></dt>
                <Icon name="building" class="size-4 text-blue-text" />
                <dd><LocalizedTextView field={organization.shortName} locale={locale} notice={false} /></dd>
              </div>
            )
          }
        </dl>
      </header>

      {
        cover && (
          <div class="mt-8 aspect-16/9 overflow-hidden rounded-card bg-eager-green">
            <PhotoImage photoId={cover.photoId} seed={report.slug} alt={stripRuby(title)} eager />
          </div>
        )
      }

      <p class="text-balance-ja mt-8 rounded-card border-l-4 border-eager-green bg-storybook-green px-5 py-4 leading-relaxed font-medium text-charcoal">
        <LocalizedTextView field={report.summary} locale={locale} />
      </p>

      <div class="mt-8">
        <BlockContent nodes={body.content} locale={locale} seed={report.slug} />
      </div>

      {
        report.photos.length > 1 && (
          <section class="mt-12">
            <h2 class="flex items-center gap-2 text-xl">
              <Icon name="camera" class="size-5 text-green-text" />
              <Ruby text={t('report.photos')} />
            </h2>
            <div class="mt-5 grid gap-5 sm:grid-cols-2">
              {report.photos.slice(1).map((photo) => (
                <figure class="min-w-0">
                  <div class="aspect-16/9 overflow-hidden rounded-card bg-eager-green">
                    <PhotoImage photoId={photo.photoId} seed={`${report.slug}-${photo.photoId}`} />
                  </div>
                  <figcaption class="text-balance-ja mt-2 text-sm text-pencil-gray">
                    <LocalizedTextView field={photo.caption} locale={locale} notice={false} />
                  </figcaption>
                </figure>
              ))}
            </div>
          </section>
        )
      }

      {
        report.sourceUrl && (
          <p class="mt-10 flex items-start gap-2 rounded-card bg-paper-white px-5 py-4 text-sm text-pencil-gray">
            <Icon name="info" class="mt-0.5 size-4 shrink-0 text-blue-text" />
            <span class="min-w-0">
              <Ruby text={t('common.source')} />：
              <a href={report.sourceUrl} target="_blank" rel="noreferrer" class="break-all text-blue-text underline-offset-2 hover:underline">
                {report.sourceLabel ? stripRuby(resolveText(report.sourceLabel, locale).text) : report.sourceUrl}
              </a>
            </span>
          </p>
        )
      }

      <footer class="mt-12 space-y-4">
        {
          relatedEvent && (
            <a href={localizePath(`/events/${relatedEvent.slug}`, locale)}
              class="group flex items-center gap-4 rounded-card bg-white p-5 border-2 border-faded-gray transition-all hover:border-eager-green">
              <Icon name="calendar" class="size-6 shrink-0 text-blue-text" />
              <span class="min-w-0 flex-1">
                <span class="block text-xs text-pencil-gray"><Ruby text={t('nav.events')} /></span>
                <span class="text-balance-ja mt-0.5 block font-bold transition-colors group-hover:text-blue-text">
                  <LocalizedTextView field={relatedEvent.title} locale={locale} notice={false} />
                </span>
              </span>
              <Icon name="arrow-right" class="size-5 shrink-0 text-faded-gray transition-all group-hover:translate-x-0.5 group-hover:text-blue-text" />
            </a>
          )
        }
        {
          organization && (
            <a href={localizePath(`/organizations/${organization.slug}`, locale)}
              class="group flex items-center gap-4 rounded-card bg-white p-5 border-2 border-faded-gray transition-all hover:border-eager-green">
              <Icon name="building" class="size-6 shrink-0 text-blue-text" />
              <span class="min-w-0 flex-1">
                <span class="block text-xs text-pencil-gray"><Ruby text={t('report.relatedOrg')} /></span>
                <span class="text-balance-ja mt-0.5 block font-bold transition-colors group-hover:text-blue-text">
                  <LocalizedTextView field={organization.name} locale={locale} notice={false} />
                </span>
              </span>
              <Icon name="arrow-right" class="size-5 shrink-0 text-faded-gray transition-all group-hover:translate-x-0.5 group-hover:text-blue-text" />
            </a>
          )
        }
      </footer>
    </article>
  </Container>

  {
    others.length > 0 && (
      <div class="bg-white py-16">
        <Container>
          <h2 class="mb-8 text-2xl">
            <span class="mr-3 inline-block h-6 w-1 translate-y-0.5 rounded-card bg-eager-green align-middle" />
            <Ruby text={t('report.others')} />
          </h2>
          <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {others.map((item) => (
              <ReportCard report={item} locale={locale} tags={bundle.tags}
                organization={findOrganization(bundle, item.organizationId)} />
            ))}
          </div>
        </Container>
      </div>
    )
  }
</BaseLayout>

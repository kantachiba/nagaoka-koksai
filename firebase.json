{
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "//": "Astro \u304c\u5168\u30da\u30fc\u30b8\u3092\u5b9f\u30d5\u30a1\u30a4\u30eb\u3068\u3057\u3066\u51fa\u529b\u3059\u308b\u305f\u3081\u3001SPA \u306e rewrite \u306f\u4e0d\u8981\u3002",
    "cleanUrls": true,
    "trailingSlash": false,
    "headers": [
      {
        "//": "\u65e2\u5b9a\u306f no-cache\u3002/en \u306e\u3088\u3046\u306a\u62e1\u5f35\u5b50\u306a\u3057\u306e\u30d1\u30b9\u306b\u3082\u52b9\u304b\u305b\u308b\u305f\u3081 ** \u3067\u53d7\u3051\u308b",
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "//": "\u30d3\u30eb\u30c9\u6210\u679c\u7269\u306f\u30d5\u30a1\u30a4\u30eb\u540d\u306b\u30cf\u30c3\u30b7\u30e5\u304c\u5165\u308b\u306e\u3067\u9577\u671f\u30ad\u30e3\u30c3\u30b7\u30e5\uff08\u4e0a\u306e\u30eb\u30fc\u30eb\u3092\u4e0a\u66f8\u304d\uff09",
        "source": "/_astro/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  }
}

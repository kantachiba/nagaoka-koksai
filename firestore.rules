rules_version = '2';

// 長岡国際交流ポータルの Firestore セキュリティルール
//
// 方針
//  - 公開済み（status == 'published'）のコンテンツは誰でも読める。
//    ビルド時に REST API で取得するため、認証なしの読み取りを許可している。
//  - 書き込みは運営メンバー（admins コレクションに登録された UID）だけ。
//  - 下書きは運営メンバーだけが読める。
//
// ⚠️ Firestore の「ルールはフィルタではない」仕様のため、一覧取得（list）では
//    個々のドキュメントの status を評価できない。取得側は必ず
//    where('status','==','published') を付けたクエリを投げること
//    （src/lib/content.ts の runQuery を参照）。
//
// ⚠️ Cloud Functions を使わない構成のため、入力の検証もここで完結させる。

service cloud.firestore {
  match /databases/{database}/documents {

    // 運営メンバーの名簿。書き込みはコンソールからのみ（クライアント不可）
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isPublished() {
      return resource.data.status == 'published';
    }

    // タグは分類そのもので秘密がないため、下書きの概念を持たせず常に読める
    match /tags/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /events/{id} {
      allow read: if isPublished() || isAdmin();
      allow write: if isAdmin();
    }

    match /reports/{id} {
      allow read: if isPublished() || isAdmin();
      allow write: if isAdmin();
    }

    match /organizations/{id} {
      allow read: if isPublished() || isAdmin();
      allow write: if isAdmin();
    }

    // ------------------------------------------------------------ B群（既定は無効）

    // 意見箱。誰でも送れるが、読めるのは運営だけ（仕様 B-2）
    match /suggestions/{id} {
      allow create: if request.resource.data.keys().hasAll(['kind', 'body', 'createdAt'])
        && request.resource.data.body is string
        && request.resource.data.body.size() > 0
        && request.resource.data.body.size() <= 2000;
      allow read, update, delete: if isAdmin();
    }

    // 参加申請。送信者は作成のみ、閲覧は運営だけ（仕様 B-3）
    match /applications/{id} {
      allow create: if request.resource.data.keys().hasAll(['eventId', 'name', 'contact', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 100;
      allow read, update, delete: if isAdmin();
    }

    // コメント。承認済みだけが公開され、承認は運営だけができる（仕様 B-1）
    match /comments/{id} {
      allow read: if resource.data.approved == true || isAdmin();
      allow create: if request.resource.data.approved == false
        && request.resource.data.keys().hasAll(['targetType', 'targetId', 'displayName', 'body', 'createdAt'])
        && request.resource.data.body is string
        && request.resource.data.body.size() > 0
        && request.resource.data.body.size() <= 1000;
      allow update, delete: if isAdmin();
    }
  }
}
